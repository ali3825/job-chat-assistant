# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL=sqlite:///./data/app.db      # or postgresql://user:pass@host/db on a hosted platform
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5

# Optional LLM. Leave LLM_PROVIDER=none to run in deterministic fallback mode.
LLM_PROVIDER=none                          # none | anthropic | openai (any OpenAI-compatible API)
LLM_API_KEY=your-key-here
LLM_MODEL=your-model-name
LLM_BASE_URL=                              # optional override
LLM_TIMEOUT_SECONDS=15

# Collector only
COLLECTOR_CONTACT=you@example.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
